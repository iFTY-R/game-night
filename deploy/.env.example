# Game Night 单容器部署环境模板。
# 所有服务共享一个 PostgreSQL DSN；密钥只需设置 GAME_NIGHT_SECRET（至少 32 字节）。

# 镜像、外部网络和宿主机入口。
GAME_NIGHT_IMAGE=ghcr.io/ifty-r/game-night:v0.0.10
GAME_NIGHT_EXTERNAL_NETWORK=1panel-network
GAME_NIGHT_HTTP_BIND_ADDRESS=127.0.0.1
GAME_NIGHT_HTTP_PUBLISHED_PORT=40891
GAME_NIGHT_STOP_GRACE_PERIOD=65s

# 应用与外部基础设施。
# 直接使用 http://IP:端口 时保持 development；启用 HTTPS 后改为 production。
GAME_NIGHT_ENVIRONMENT=development
GAME_NIGHT_DATABASE_SCHEMA=game_night
GAME_NIGHT_DATABASE_URL=postgresql://game_night:hMnfxfHQa3YKYGDR@1Panel-postgresql-z3Hy:5432/game_night?sslmode=disable
GAME_NIGHT_REDIS_URL=redis://:redis_yKSN8d@1Panel-redis-FZYt:6379
GAME_NIGHT_REDIS_KEY_PREFIX=game-night:compose:
GAME_NIGHT_REDIS_TIMEOUT=1s

# 单一主密钥。launcher 会在容器临时目录生成用途隔离的运行时 keyring 和内部 token。
GAME_NIGHT_SECRET=WnOO_AcidC5l2EB6ophU1274mQkC8Ymo9U784zzB0-sM8f_OI_yfqWmB1tBBBN4l

# 审计检查点。
GAME_NIGHT_AUDIT_CHECKPOINT_MAX_EVENTS=100
GAME_NIGHT_AUDIT_CHECKPOINT_MAX_INTERVAL=5m
