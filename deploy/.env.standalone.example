# Standalone / 1Panel 小规模生产部署模板。
# 复制为 .env 后填写外部 PostgreSQL/Redis 与 Base64 secret；部署目录无需 secrets 子目录。

# 镜像、外部网络和宿主机入口。
GAME_NIGHT_IMAGE=ghcr.io/ifty-r/game-night:latest
GAME_NIGHT_SECRETS_INIT_IMAGE=alpine:3.22
GAME_NIGHT_EXTERNAL_NETWORK=1panel-network
GAME_NIGHT_HTTP_BIND_ADDRESS=127.0.0.1
GAME_NIGHT_HTTP_PUBLISHED_PORT=40891
GAME_NIGHT_STOP_GRACE_PERIOD=65s

# 本编排使用持久化本地 checkpoint，可在受控私网中直接运行 production。
GAME_NIGHT_ENVIRONMENT=production
GAME_NIGHT_DATABASE_SCHEMA=game_night

# 浏览器访问地址和 Edge Host 白名单。
GAME_NIGHT_USER_ORIGINS=http://127.0.0.1:40891
GAME_NIGHT_ADMIN_ORIGINS=http://admin.localhost:40891
# 127.0.0.1:8080 是容器内 healthcheck authority，必须保留。
GAME_NIGHT_EDGE_USER_HOSTS=localhost:40891,127.0.0.1:40891,127.0.0.1:8080
GAME_NIGHT_EDGE_ADMIN_HOSTS=admin.localhost:40891
GAME_NIGHT_COOKIE_SECURE=false
GAME_NIGHT_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
GAME_NIGHT_EDGE_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Redis；共享实例必须使用独立 key 前缀。
GAME_NIGHT_REDIS_URL=redis://:change-me@redis:6379/0
GAME_NIGHT_REDIS_KEY_PREFIX=game-night:standalone:
GAME_NIGHT_REDIS_TIMEOUT=1s

# 内部服务 token，至少 32 个随机可打印字符且两项不能留空。
GAME_NIGHT_REALTIME_INTERNAL_TOKEN=
GAME_NIGHT_ADMIN_HEARTBEAT_TOKEN=

# PostgreSQL。四个 DSN 可以使用同一账号，但必须指向隔离的 game_night schema。
GAME_NIGHT_API_DATABASE_URL=postgresql://change-me@postgres:5432/game_night?sslmode=disable
GAME_NIGHT_REALTIME_DATABASE_URL=postgresql://change-me@postgres:5432/game_night?sslmode=disable
GAME_NIGHT_WORKER_DATABASE_URL=postgresql://change-me@postgres:5432/game_night?sslmode=disable
GAME_NIGHT_MIGRATION_DATABASE_URL=postgresql://change-me@postgres:5432/game_night?sslmode=disable

# 单账号部署可将五项配置为同一个 PostgreSQL role。
GAME_NIGHT_DATABASE_OWNER_ROLE=
GAME_NIGHT_DATABASE_AUDIT_WRITER_ROLE=
GAME_NIGHT_DATABASE_MIGRATION_ROLE=
GAME_NIGHT_DATABASE_RUNTIME_ROLE=
GAME_NIGHT_DATABASE_WORKER_ROLE=

# 首次管理员初始化完成后可设为空值并重新部署。
GAME_NIGHT_API_BOOTSTRAP_SECRET_FILE=/run/game-night/api-secrets/admin-bootstrap.txt

# 每项是对应原始 secret 文件内容的 Base64；secrets-init 会写入用途隔离的命名卷。
GAME_NIGHT_SECRET_ADMIN_BOOTSTRAP_B64=
GAME_NIGHT_SECRET_ADMIN_CHALLENGE_B64=
GAME_NIGHT_SECRET_ADMIN_CURSOR_B64=
GAME_NIGHT_SECRET_ADMIN_SESSION_B64=
GAME_NIGHT_SECRET_AUDIT_B64=
GAME_NIGHT_SECRET_DEVICE_B64=
GAME_NIGHT_SECRET_PII_B64=
GAME_NIGHT_SECRET_RATE_LIMIT_B64=
GAME_NIGHT_SECRET_RESULT_ENVELOPE_B64=
GAME_NIGHT_SECRET_TOTP_B64=
GAME_NIGHT_SECRET_USER_CHALLENGE_B64=
